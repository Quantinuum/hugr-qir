#!/usr/bin/env python

import sys
from pathlib import Path

from hugr_qir.hugr_to_qir import hugr_to_qir
from hugr_qir.output import OutputFormat
from utils import load_py_module_from_path

if __name__ == "__main__":
    try:
        guppy_file = sys.argv[1]
    except IndexError:
        print("Missing guppy file input argument")
        guppy_file = None

    if guppy_file:
        guppy_example = load_py_module_from_path("guppy_example_mod", str(guppy_file))
        hugr_package = guppy_example.main.compile()
        qir_ir = hugr_to_qir(hugr_package, output_format=OutputFormat.LLVM_IR)
        assert isinstance(qir_ir, str)  # noqa: S101
        qir_file = Path(f"{Path(guppy_file).stem}.ll")
        with qir_file.open("w") as qir:
            qir.write(qir_ir)
