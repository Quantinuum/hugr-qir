source_filename = "tail_switch_terminator"
target datalayout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
target triple = "aarch64-unknown-linux-gnu"

@0 = private unnamed_addr constant [6 x i8] c"which\00", align 1

define void @__hugr__.main.1(i1 %cond, i1 %flag) {
entry:
  br i1 %cond, label %entry.select.merge.dup, label %entry.select.merge.dup3

entry.select.merge.dup:                           ; preds = %entry
  %idx12 = zext i1 %flag to i64
  %switch.selectcmp = icmp eq i64 %idx12, 0
  %switch.select = select i1 %switch.selectcmp, i64 0, i64 1
  br label %record_block

entry.select.merge.dup3:                          ; preds = %entry
  %idx14 = zext i1 %flag to i64
  %switch.selectcmp5 = icmp eq i64 %idx14, 0
  %switch.select6 = select i1 %switch.selectcmp5, i64 0, i64 1
  br label %record_block

record_block:                                     ; preds = %entry.select.merge.dup, %entry.select.merge.dup3
  %which = phi i64 [ %switch.select, %entry.select.merge.dup ], [ %switch.select6, %entry.select.merge.dup3 ]
  call void @__quantum__rt__int_record_output(i64 %which, i8* getelementptr inbounds ([6 x i8], [6 x i8]* @0, i64 0, i64 0))
  ret void
}

declare void @__quantum__rt__int_record_output(i64, i8*)
