define { ptr, i1 } @_hl.main.1(ptr %0) {
alloca_block:
  %"0" = alloca ptr, align 8
  %"1" = alloca i1, align 1
  %"2_0" = alloca ptr, align 8
  %"4_0" = alloca ptr, align 8
  %"4_1" = alloca i1, align 1
  br label %entry_block

entry_block:                                      ; preds = %alloca_block
  store ptr %0, ptr %"2_0", align 8
  %"2_01" = load ptr, ptr %"2_0", align 8
  %1 = call ptr @__QIR__CONV_Qubit_TO_Result(ptr %"2_01")
  call void @__quantum__qis__mz__body(ptr %"2_01", ptr %1)
  call void @__quantum__qis__reset__body(ptr %"2_01")
  %2 = call i1 @__quantum__rt__read_result(ptr %1)
  %3 = select i1 %2, i1 true, i1 false
  store ptr %"2_01", ptr %"4_0", align 8
  store i1 %3, ptr %"4_1", align 1
  %"4_02" = load ptr, ptr %"4_0", align 8
  %"4_13" = load i1, ptr %"4_1", align 1
  store ptr %"4_02", ptr %"0", align 8
  store i1 %"4_13", ptr %"1", align 1
  %"04" = load ptr, ptr %"0", align 8
  %"15" = load i1, ptr %"1", align 1
  %mrv = insertvalue { ptr, i1 } poison, ptr %"04", 0
  %mrv6 = insertvalue { ptr, i1 } %mrv, i1 %"15", 1
  ret { ptr, i1 } %mrv6
}

declare ptr @__QIR__CONV_Qubit_TO_Result(ptr)

declare void @__quantum__qis__mz__body(ptr, ptr writeonly) #0

