  store i1 %3, ptr %"8_1", align 1
  %"8_13" = load i1, ptr %"8_1", align 1
  %4 = insertvalue { i1, i1 } { i1 true, i1 poison }, i1 %"8_13", 1
  store { i1, i1 } %4, ptr %"9_0", align 1
  %"8_04" = load ptr, ptr %"8_0", align 8
  %"9_05" = load { i1, i1 }, ptr %"9_0", align 1
  store ptr %"8_04", ptr %"4_0", align 8
  store { i1, i1 } %"9_05", ptr %"4_1", align 1
  %"4_06" = load ptr, ptr %"4_0", align 8
  %"4_17" = load { i1, i1 }, ptr %"4_1", align 1
  store ptr %"4_06", ptr %"0", align 8
  store { i1, i1 } %"4_17", ptr %"1", align 1
  %"08" = load ptr, ptr %"0", align 8
  %"19" = load { i1, i1 }, ptr %"1", align 1
  %mrv = insertvalue { ptr, { i1, i1 } } poison, ptr %"08", 0
  %mrv10 = insertvalue { ptr, { i1, i1 } } %mrv, { i1, i1 } %"19", 1
  ret { ptr, { i1, i1 } } %mrv10
